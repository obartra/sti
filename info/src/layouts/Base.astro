---
// The shared page frame for info.sti.care. Imports the app's design tokens and
// component classes directly from the passport package (one source of truth for the
// palette, type, and primitives, never a duplicated theme), then the small
// site-specific stylesheets on top: site.css is the phone column, desktop.css the
// wide-screen layer. A slim header links back to the app; the footer crosses the
// library and back to sti.care. Pages composed for wide screens pass `wide`;
// without it the main column keeps the phone width everywhere.
import "../../../passport/src/design/index.css";
import "../styles/site.css";
import "../styles/desktop.css";
import { SITE } from "../data/site.ts";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const {
  title,
  description = "Plain, judgment-free answers about sexual health, testing, and prevention.",
  wide = false,
} = Astro.props;

const APP_URL = "https://sti.care";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <header class="info-header">
      <div class="info-header__inner">
        <a class="info-home" href="/">
          <span class="info-home__brand">{SITE.brand}</span>
          <span class="info-home__tag">{SITE.tag}</span>
        </a>
        <nav class="info-header__nav">
          {SITE.nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <a class="info-toapp" href={APP_URL}>{SITE.backToApp}</a>
      </div>
    </header>
    <main class:list={["info-page", { "info-page--wide": wide }]}>
      <slot />
    </main>
    <footer class="info-footer">
      <div class="info-footer__inner">
        <div class="info-footer__brand">
          <span class="info-home__brand">{SITE.brand}</span>
          <span class="info-home__tag">{SITE.tag}</span>
        </div>
        <nav class="info-footer__links">
          {SITE.nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="info-footer__end">
          <div class="info-footer__tag">{SITE.tagline}</div>
          <div class="info-footer__note">{SITE.note}</div>
        </div>
      </div>
    </footer>
  </body>
</html>
