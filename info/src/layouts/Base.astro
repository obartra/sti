---
// The shared page frame for info.sti.care. One layered stylesheet entry
// (styles/global.css) carries the passport tokens, the editorial theme, and,
// during the migration, the legacy sheets. Chrome is the flat editorial header
// and footer. Pages built on the editorial system pass `editorial`; pages not
// yet migrated keep the legacy phone-column main (and its `wide` modifier).
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  editorial?: boolean;
  wide?: boolean;
}
const {
  title,
  description = "Plain, judgment-free answers about sexual health, testing, and prevention.",
  editorial = false,
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <SiteHeader />
    <main
      class:list={editorial
        ? ["l-page"]
        : ["info-page", { "info-page--wide": wide }]}
    >
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
