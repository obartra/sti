---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SharePage from "../components/SharePage.astro";
import { UU as u } from "../data/uu.ts";
import { LIBRARY as c } from "../data/library.ts";
import { emph } from "../lib/emph.ts";

// The U=U page: a made-to-share explainer, deliberately separate from anyone's
// status. On a phone the hero and cards stack; at desktop the hero is a wide band
// and the questions sit two across.
---

<Base title="Undetectable = Untransmittable (U=U)" description={u.intro} wide>
  <section class="info-section">
    <div class="info-hero">
      <span class="info-hero__label">{u.label}</span>
      <h1 class="info-hero__title">{u.title}</h1>
      <p class="info-hero__intro">{u.intro}</p>
    </div>
  </section>

  <section class="info-section">
    <div class="info-stack info-qa-grid">
      {
        u.qa.map((row) => (
          <div class="sti-card info-uu-card">
            <div class="info-uu-card__q">{row[0]}</div>
            <div class="info-uu-card__a" set:html={emph(row[1])} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="info-section info-uu-foot">
    <div class="sti-card sti-card--tint info-row info-row--top">
      <span class="info-row__icon">
        <Icon name="lock" size={17} />
      </span>
      <div class="info-finetext">{u.privacyNote}</div>
    </div>

    <SharePage label={c.shareLabel} copied={c.copied} />
  </section>

  <section class="info-section">
    <div class="info-sources info-sources--center">
      <div class="info-sources__label">{c.sourcesLabel}</div>
      {
        u.sources.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            {s.label}
          </a>
        ))
      }
    </div>
    <div class="info-disclaimer">{u.disclaimer}</div>
  </section>
</Base>
