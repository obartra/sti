---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SharePage from "../components/SharePage.astro";
import { UU as u } from "../data/uu.ts";
import { LIBRARY as c } from "../data/library.ts";
import { emph } from "../lib/emph.ts";

// The U=U page: a made-to-share explainer, deliberately separate from anyone's
// status. Ported from the app's UU card.
---

<Base title="Undetectable = Untransmittable (U=U)" description={u.intro}>
  <div class="info-hero">
    <span class="info-hero__label">{u.label}</span>
    <h1 class="info-hero__title">{u.title}</h1>
    <p class="info-hero__intro">{u.intro}</p>
  </div>

  <div class="info-stack">
    {
      u.qa.map((row) => (
        <div class="sti-card" style="display:flex;flex-direction:column;gap:6px">
          <div style="font-size:15px;font-weight:700;color:var(--text-strong)">
            {row[0]}
          </div>
          <div
            style="font-size:14px;line-height:1.6;color:var(--text-body)"
            set:html={emph(row[1])}
          />
        </div>
      ))
    }
  </div>

  <div class="sti-card sti-card--tint info-row" style="gap:12px;align-items:flex-start">
    <span style="color:var(--text-accent);flex:none;margin-top:1px">
      <Icon name="lock" size={17} />
    </span>
    <div style="font-size:13px;line-height:1.55;color:var(--text-body)">
      {u.privacyNote}
    </div>
  </div>

  <SharePage label={c.shareLabel} copied={c.copied} />

  <div class="info-disclaimer">{u.disclaimer}</div>
</Base>
