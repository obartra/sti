---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Callout from "../components/Callout.astro";
import ConditionTable from "../components/ConditionTable.astro";
import GuideRow from "../components/GuideRow.astro";
import SectionHead from "../components/SectionHead.astro";
import ValueBand from "../components/ValueBand.astro";
import { LIBRARY as c } from "../data/library.ts";
import { RESOURCES } from "../data/resources.ts";
import { SITE } from "../data/site.ts";
import { SECTIONS } from "../data/sections.ts";

// The library index. Source order is the phone priority order: the lookup
// (title, condition table), the one primary action, the time-critical PEP
// callout, then the topic sections, the prevention band, and the closing
// restatement. At 900px the hero becomes copy-beside-table and each topic
// section becomes a title rail beside its rows.
const conditions = (await getCollection("conditions")).sort(
  (a, b) => a.data.order - b.data.order,
);
const guides = (await getCollection("guides")).sort(
  (a, b) => a.data.order - b.data.order,
);
const bySection = (id: string) => guides.filter((g) => g.data.topic === id);
const sections = SECTIONS.filter(
  (s) => s.id === "positive" || bySection(s.id).length > 0,
);
---

<Base title="STI basics" description={c.sub}>
  <section class="hero l-frame l-grid">
    <div class="hero__head">
      <p class="u-eyebrow">{c.eyebrow}</p>
      <h1 class="hero__title">{c.title}</h1>
      <p class="hero__lead">{c.sub}</p>
    </div>
    <div class="hero__side l-zone">
      <ConditionTable conditions={conditions} eyebrow={c.conditionsLabel} />
    </div>
    <div class="hero__cta">
      <a
        class="sti-btn sti-btn--primary sti-btn--lg u-btn-fluid hero__btn"
        href={RESOURCES.clinic}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="sti-btn__icon"><Icon name="mapPin" size={18} /></span>{
          c.testing.findTesting
        }
      </a>
      <p class="hero__note u-micro">{SITE.note}</p>
    </div>
  </section>

  <div class="l-frame l-section">
    <Callout variant="urgent">
      <div class="pep">
        <div class="pep__copy">
          <p class="pep__title">
            {c.pep.title}
            <span class="pep__meta">{c.pep.chip}</span>
          </p>
          <p class="pep__body">{c.pep.body}</p>
        </div>
        <a
          class="sti-btn sti-btn--secondary sti-btn--md u-btn-fluid pep__btn"
          href={RESOURCES.pep}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="sti-btn__icon"><Icon name="mapPin" size={16} /></span>{
            c.pep.cta
          }
        </a>
      </div>
    </Callout>
  </div>

  {
    sections.map((section, i) => (
      <section class="topic l-frame l-grid l-section">
        <div class="topic__rail">
          <SectionHead
            number={String(i + 1).padStart(2, "0")}
            id={section.id}
            title={section.title}
            sub={section.sub}
          />
        </div>
        <div class="topic__rows l-zone">
          <div class="topic__grid">
            {section.id === "positive" && (
              <GuideRow href="/uu" title={c.uuCard.title} tag={c.uuCard.sub} />
            )}
            {bySection(section.id).map((g) => (
              <GuideRow
                href={`/${g.id}`}
                title={g.data.title}
                tag={g.data.tag}
              />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <div class="l-band l-section">
    <ValueBand />
  </div>

  <div class="l-frame l-section">
    <Callout variant="action">
      <div class="cta">
        <p class="cta__copy">{c.testing.disclaimer}</p>
        <div class="cta__action">
          <a
            class="sti-btn sti-btn--primary sti-btn--lg u-btn-fluid cta__btn"
            href={RESOURCES.clinic}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="sti-btn__icon"><Icon name="mapPin" size={18} /></span>{
              c.testing.findTesting
            }
          </a>
          <p class="cta__sub u-micro">{c.testing.findTestingSub}</p>
          <a
            class="cta__official"
            href={RESOURCES.clinic}
            target="_blank"
            rel="noopener noreferrer"
          >
            {c.testing.official}
          </a>
        </div>
      </div>
    </Callout>
  </div>

  <div class="l-frame l-section">
    <p class="disclaimer u-micro">{c.footer}</p>
  </div>
</Base>

<style>
  /* ---- hero: lookup first ---- */
  .hero {
    padding-top: var(--space-6);
  }
  .hero__title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--type-display);
    line-height: 1.08;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--text-strong);
    margin: var(--space-3) 0 0;
  }
  .hero__lead {
    font-size: var(--type-lead);
    line-height: 1.6;
    color: var(--text-body);
    margin: var(--space-4) 0 0;
    max-width: 46ch;
  }
  .hero__side {
    margin-top: var(--space-6);
  }
  .hero__cta {
    margin-top: var(--space-6);
  }
  .hero__note {
    display: flex;
    gap: 8px;
    margin: var(--space-4) 0 0;
    max-width: 52ch;
  }

  /* ---- the PEP callout row ---- */
  .pep__title {
    font-size: 16px;
    font-weight: var(--weight-bold);
    color: var(--text-strong);
    margin: 0;
  }
  .pep__meta {
    display: inline-block;
    margin-left: 10px;
    font-size: 12px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--status-ink-treat);
    white-space: nowrap;
  }
  .pep__body {
    font-size: 14px;
    line-height: var(--leading-normal);
    color: var(--text-body);
    margin: var(--space-2) 0 0;
    max-width: 72ch;
  }
  .pep__btn {
    margin-top: var(--space-4);
  }

  /* ---- topic sections ---- */
  .topic__rows {
    margin-top: var(--space-4);
  }
  .topic__grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--grid-gap);
  }
  @container (min-width: 560px) {
    .topic__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---- closing CTA ---- */
  .cta__copy {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-body);
    margin: 0;
    max-width: 56ch;
  }
  .cta__action {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
  .cta__sub {
    margin: 0;
    text-align: center;
  }
  .cta__official {
    font-size: 13px;
    font-weight: var(--weight-semibold);
    color: var(--text-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .disclaimer {
    text-align: center;
    max-width: 62ch;
    margin: 0 auto;
  }

  /* ---- 900px compositions ---- */
  @media (min-width: 900px) {
    .hero {
      padding-top: var(--space-8);
      row-gap: 0;
    }
    .hero__head {
      grid-column: 1 / 8;
      grid-row: 1;
    }
    .hero__side {
      grid-column: 8 / 13;
      grid-row: 1 / 3;
      margin-top: 0;
    }
    .hero__cta {
      grid-column: 1 / 8;
      grid-row: 2;
      align-self: end;
      margin-top: var(--space-6);
    }
    .hero__btn {
      width: auto;
    }

    .pep {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: var(--space-7);
    }
    .pep__btn {
      width: auto;
      margin-top: 0;
    }

    .topic__rail {
      grid-column: 1 / 5;
    }
    .topic__rows {
      grid-column: 5 / 13;
      margin-top: 0;
    }

    .cta {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: var(--space-8);
    }
    .cta__copy {
      font-size: 16.5px;
    }
    .cta__action {
      margin-top: 0;
    }
    .cta__action :global(.cta__btn) {
      width: auto;
    }
  }
</style>
