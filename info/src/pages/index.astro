---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Chip from "../components/Chip.astro";
import Icon from "../components/Icon.astro";
import { LIBRARY as c } from "../data/library.ts";
import { RESOURCES } from "../data/resources.ts";
import { SITE } from "../data/site.ts";
import { SECTIONS } from "../data/sections.ts";

// The library index. On a phone: the tappable condition list, the U=U card, and
// the prevention / vaccine / testing framing, stacked. At desktop the same content
// composes like the app's landing: a hero row (copy beside the condition list),
// the PEP callout, the link-card grid, a full-bleed value band, and a closing
// testing call to action.
const conditions = (await getCollection("conditions")).sort(
  (a, b) => a.data.order - b.data.order,
);
const guides = (await getCollection("guides")).sort(
  (a, b) => a.data.order - b.data.order,
);
const bySection = (id: string) => guides.filter((g) => g.data.topic === id);
---

<Base title="STI basics" description={c.sub} wide>
  <section class="info-section info-lede">
    <div class="info-lede__copy">
      <div class="info-eyebrow info-desktop">{c.eyebrow}</div>
      <div>
        <h1 class="info-title">{c.title}</h1>
        <p class="info-lead">{c.sub}</p>
      </div>
      <div class="info-lede__extra info-desktop">
        <div class="info-lede__cta">
          <a
            class="sti-btn sti-btn--primary sti-btn--lg"
            href={RESOURCES.clinic}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="sti-btn__icon"><Icon name="mapPin" size={18} /></span>{
              c.testing.findTesting
            }
          </a>
        </div>
        <div class="info-lede__note">
          <Icon name="stethoscope" size={15} />
          {SITE.note}
        </div>
      </div>
    </div>
    <div class="info-lede__side">
      <div class="sti-card sti-card--flat info-list">
        {
          conditions.map((cond) => (
            <a class="info-list__row" href={`/${cond.slug}`}>
              <span class="info-list__name">{cond.data.name}</span>
              <Chip label={cond.data.label} tone={cond.data.tone} />
              <Icon name="chevron" size={17} class="info-list__chev" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="info-section">
    <div class="sti-card sti-card--flat info-stack info-callout">
      <div class="info-row info-row--between">
        <div class="info-row info-row--snug">
          <span class="info-tile info-tile--treat info-tile--sm">
            <Icon name="clock" size={19} />
          </span>
          <span class="info-cardtitle">{c.pep.title}</span>
        </div>
        <span class="info-pillcap">{c.pep.chip}</span>
      </div>
      <div class="info-note">{c.pep.body}</div>
      <a
        class="sti-btn sti-btn--secondary sti-btn--md sti-btn--block info-callout__cta"
        href={RESOURCES.pep}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="sti-btn__icon"><Icon name="mapPin" size={16} /></span>{c.pep.cta}
      </a>
    </div>
  </section>

  {
    SECTIONS.filter(
      (section) =>
        section.id === "positive" || bySection(section.id).length > 0,
    ).map((section) => (
      <section class="info-section">
        <div class="info-secthead" id={section.id}>
          <h2 class="info-secthead__title">{section.title}</h2>
          <p class="info-secthead__sub">{section.sub}</p>
        </div>
        <div class="info-grid2">
          {section.id === "positive" && (
            <a class="sti-card sti-card--tint info-row" href="/uu">
              <span class="info-tile info-tile--clear">U=U</span>
              <div class="info-cardlink__body">
                <div class="info-cardtitle">{c.uuCard.title}</div>
                <div class="info-cardsub">{c.uuCard.sub}</div>
              </div>
              <Icon name="chevron" size={17} class="info-list__chev" />
            </a>
          )}
          {bySection(section.id).map((g) => (
            <a class="sti-card sti-card--tint info-row" href={`/${g.slug}`}>
              <span class="info-tile info-tile--accent">
                <Icon name={g.data.icon} size={19} />
              </span>
              <div class="info-cardlink__body">
                <div class="info-cardtitle">{g.data.title}</div>
                <div class="info-cardsub">{g.data.tag}</div>
              </div>
              <Icon name="chevron" size={17} class="info-list__chev" />
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <div class="info-band">
    <div class="info-band__inner info-valueband">
      <div class="sti-card sti-card--flat info-panel">
        <div>
          <div class="info-cardtitle">{c.tools.title}</div>
          <div class="info-cardsub">{c.tools.body}</div>
        </div>
        {
          c.tools.items.map((row) => (
            <div class="info-item">
              <span class="info-item__icon"><Icon name="shield" size={16} /></span>
              <div>
                {row.href ? (
                  <a href={row.href}>
                    <strong>{row.term}</strong>
                  </a>
                ) : (
                  <strong>{row.term}</strong>
                )}, {row.sub}
              </div>
            </div>
          ))
        }
      </div>

      <div class="sti-card sti-card--flat info-panel">
        <div>
          <div class="info-cardtitle">{c.vax.title}</div>
          <div class="info-cardsub">{c.vax.body}</div>
        </div>
        {
          c.vax.items.map((row) => (
            <div class="info-item">
              <span class="info-item__icon"><Icon name="stethoscope" size={16} /></span>
              <div>
                {row.href ? (
                  <a href={row.href}>
                    <strong>{row.term}</strong>
                  </a>
                ) : (
                  <strong>{row.term}</strong>
                )}, {row.sub}
              </div>
            </div>
          ))
        }
        <a
          class="sti-btn sti-btn--secondary sti-btn--md sti-btn--block"
          href={RESOURCES.clinic}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="sti-btn__icon"><Icon name="mapPin" size={16} /></span>{c.vax.cta}
        </a>
      </div>

      <div class="sti-card sti-card--flat info-panel">
        <div>
          <div class="info-cardtitle">{c.clinician.title}</div>
          <div class="info-cardsub">{c.clinician.body}</div>
        </div>
        {
          c.clinician.items.map((row) => (
            <div class="info-item">
              <span class="info-item__icon"><Icon name="check" size={16} /></span>
              <div>
                <strong>{row.term}</strong>, {row.sub}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <section class="info-section">
    <div class="sti-card sti-card--flat info-panel info-cta">
      <div class="info-note">{c.testing.disclaimer}</div>
      <div class="info-cta__action">
        <a
          class="sti-btn sti-btn--primary sti-btn--lg sti-btn--block"
          href={RESOURCES.clinic}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="sti-btn__icon"><Icon name="mapPin" size={18} /></span>{
            c.testing.findTesting
          }
        </a>
        <div class="info-subnote">{c.testing.findTestingSub}</div>
        <a
          class="info-textlink"
          href={RESOURCES.clinic}
          target="_blank"
          rel="noopener noreferrer"
        >
          {c.testing.official}
        </a>
      </div>
    </div>
  </section>

  <section class="info-section">
    <div class="info-disclaimer">{c.footer}</div>
  </section>
</Base>
