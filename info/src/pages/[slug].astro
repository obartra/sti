---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Chip from "../components/Chip.astro";
import Icon from "../components/Icon.astro";
import SharePage from "../components/SharePage.astro";
import { LIBRARY as c } from "../data/library.ts";
import { RESOURCES } from "../data/resources.ts";

// One page per condition explainer, at the root (info.sti.care/gonorrhea). The
// filename is the slug. Ported from the app's Detail.
export const getStaticPaths = (async () => {
  const conditions = await getCollection("conditions");
  return conditions.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
---

<Base title={`${d.name} · STI basics`} description={d.intro}>
  <div>
    <div class="info-titlerow">
      <h1 class="info-title" style="font-size:27px">{d.name}</h1>
      <Chip label={d.label} tone={d.tone} />
    </div>
    <p class="info-lead" style="font-size:15px;color:var(--text-body)">{d.intro}</p>
  </div>

  <article class="sti-card sti-card--flat info-qa">
    <Content />
  </article>

  <div class="sti-card sti-card--tint info-row" style="align-items:flex-start;gap:12px">
    <span
      class="info-tile info-tile--accent"
      style="width:38px;height:38px;border-radius:var(--radius-sm)"
    >
      <Icon name="stethoscope" size={19} />
    </span>
    <div>
      <div style="font-size:13.5px;font-weight:700;color:var(--text-strong)">
        {c.howToTest}
      </div>
      <div class="info-note" style="margin-top:2px">{d.test}</div>
    </div>
  </div>

  {
    entry.slug === "hiv" && (
      <a class="sti-card sti-card--tint info-row" href="/uu">
        <span class="info-tile info-tile--clear" style="width:38px;height:38px;font-size:12px">
          U=U
        </span>
        <span style="flex:1;font-size:14px;font-weight:600;color:var(--text-strong)">
          {c.uuFromHiv}
        </span>
        <Icon name="arrowRight" size={17} style="color:var(--text-accent);flex:none" />
      </a>
    )
  }

  <a
    class="sti-btn sti-btn--primary sti-btn--lg sti-btn--block"
    href={RESOURCES.clinic}
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="sti-btn__icon"><Icon name="mapPin" size={18} /></span>{
      c.testing.findTesting
    }
  </a>
  <div class="info-subnote">{c.testing.findTestingSub}</div>

  <SharePage label={c.shareLabel} copied={c.copied} />

  <div class="info-disclaimer">{c.footer}</div>
</Base>
