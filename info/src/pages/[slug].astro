---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import StatusLabel from "../components/StatusLabel.astro";
import FactsStrip from "../components/FactsStrip.astro";
import Callout from "../components/Callout.astro";
import ClinicianList from "../components/ClinicianList.astro";
import SourceList from "../components/SourceList.astro";
import SharePage from "../components/SharePage.astro";
import { LIBRARY as c } from "../data/library.ts";
import { RESOURCES } from "../data/resources.ts";
import { SECTIONS } from "../data/sections.ts";

// One page per condition explainer and per guide, all at the root. Source
// order is the phone priority order: head, the condition facts, the action,
// the article, then the supportive pieces. At 900px the article is the
// reading column and the action card pins beside it while it scrolls.
export const getStaticPaths = (async () => {
  const conditions = await getCollection("conditions");
  const guides = await getCollection("guides");

  // Every slug across both collections and the reserved pages must be unique,
  // so a clash can never ship silently (doc 34).
  const seen = new Set(["uu", "styleguide"]);
  for (const entry of [...conditions, ...guides]) {
    if (seen.has(entry.slug)) {
      throw new Error(`info route collision on /${entry.slug}`);
    }
    seen.add(entry.slug);
  }

  return [
    ...conditions.map((entry) => ({
      params: { slug: entry.slug },
      props: { kind: "condition" as const, entry },
    })),
    ...guides.map((entry) => ({
      params: { slug: entry.slug },
      props: { kind: "guide" as const, entry },
    })),
  ];
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const props = Astro.props as Props;

const cond = props.kind === "condition" ? props.entry : undefined;
const guide = props.kind === "guide" ? props.entry : undefined;
const { Content } = await props.entry.render();

const pageTitle = cond?.data.name ?? guide?.data.title ?? "";
const intro = cond?.data.intro ?? guide?.data.intro ?? "";
const sources = cond?.data.sources ?? guide?.data.sources;
const eyebrow = cond
  ? c.conditionEyebrow
  : (SECTIONS.find((s) => s.id === guide?.data.topic)?.title ?? "");
const guideCta = guide?.data.cta
  ? { label: c.guideCtas[guide.data.cta], href: RESOURCES[guide.data.cta] }
  : null;
---

<Base title={`${pageTitle} · STI basics`} description={intro}>
  <article class="det l-frame l-grid">
    <header class="det__head">
      <p class="u-eyebrow">{eyebrow}</p>
      <div class="det__titlerow">
        <h1 class="det__title">{pageTitle}</h1>
        {cond && <StatusLabel label={cond.data.label} tone={cond.data.tone} />}
      </div>
      <p class="det__lead">{intro}</p>
    </header>

    {
      cond && (
        <div class="det__facts l-zone">
          <FactsStrip
            test={cond.data.test}
            label={cond.data.label}
            tone={cond.data.tone}
            related={cond.data.related}
          />
        </div>
      )
    }

    <div class="det__cta">
      <Callout variant="action">
        <div class="det__ctainner">
          {
            guideCta && (
              <a
                class="sti-btn sti-btn--primary sti-btn--lg u-btn-fluid"
                href={guideCta.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="sti-btn__icon">
                  <Icon name="mapPin" size={18} />
                </span>
                {guideCta.label}
              </a>
            )
          }
          <a
            class:list={[
              "sti-btn",
              "u-btn-fluid",
              guideCta
                ? ["sti-btn--secondary", "sti-btn--md"]
                : ["sti-btn--primary", "sti-btn--lg"],
            ]}
            href={RESOURCES.clinic}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="sti-btn__icon"><Icon name="mapPin" size={16} /></span>{
              c.testing.findTesting
            }
          </a>
          <p class="det__ctasub u-micro">{c.testing.findTestingSub}</p>
        </div>
      </Callout>
    </div>

    <div class="det__prose">
      <div class="prose">
        <Content />
      </div>
      {
        sources && (
          <div class="det__sources">
            <SourceList label={c.sourcesLabel} sources={sources} />
          </div>
        )
      }
    </div>

    <aside class="det__aside">
      <ClinicianList />
      <div class="det__share">
        <SharePage label={c.shareLabel} copied={c.copied} />
      </div>
    </aside>
  </article>

  <div class="l-frame l-section">
    <p class="det__disclaimer u-micro">{c.footer}</p>
  </div>
</Base>

<style>
  .det {
    padding-top: var(--space-6);
    row-gap: 0;
  }
  .det__titlerow {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }
  .det__title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--type-title);
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--text-strong);
    margin: 0;
  }
  .det__lead {
    font-size: var(--type-lead);
    line-height: 1.6;
    color: var(--text-body);
    margin: var(--space-4) 0 0;
    max-width: 62ch;
  }
  .det__facts {
    margin-top: var(--space-6);
  }
  .det__cta {
    margin-top: var(--space-6);
  }
  .det__ctainner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .det__ctasub {
    margin: 0;
    text-align: center;
  }
  .det__prose {
    margin-top: var(--space-7);
  }
  .det__sources {
    margin-top: var(--space-7);
    max-width: var(--measure);
  }
  .det__aside {
    margin-top: var(--space-7);
  }
  .det__share {
    margin-top: var(--space-5);
    max-width: 340px;
  }
  .det__disclaimer {
    text-align: center;
    max-width: 62ch;
    margin: 0 auto;
  }

  @media (min-width: 900px) {
    .det {
      padding-top: var(--space-8);
    }
    .det__head {
      grid-column: 1 / 9;
      grid-row: 1;
    }
    .det__facts {
      grid-column: 1 / 13;
      grid-row: 2;
      margin-top: var(--space-7);
    }
    .det__cta {
      grid-column: 9 / 13;
      grid-row: 3;
      margin-top: var(--space-7);
      align-self: start;
      position: sticky;
      top: var(--header-clear);
    }
    .det__prose {
      grid-column: 1 / 9;
      grid-row: 3;
      margin-top: var(--space-7);
    }
    .det__aside {
      grid-column: 9 / 13;
      grid-row: 4;
      align-self: start;
      margin-top: var(--space-7);
    }
  }
</style>
