---
// The site header: flat warm surface over a hairline, sticky at desktop.
// Brand left, section nav center-right (desktop only; the index and footer
// carry the same destinations below 900px), and the way back to the app as a
// quiet bordered control.
import { SITE } from "../data/site.ts";
import { SECTIONS } from "../data/sections.ts";

const APP_URL = "https://sti.care";
const nav = [
  SITE.nav[0],
  ...SECTIONS.map((s) => ({ label: s.navLabel, href: `/#${s.id}` })),
  SITE.nav[1],
];
---

<header class="hdr">
  <div class="hdr__inner l-frame">
    <a class="hdr__home" href="/">
      <span class="hdr__brand">{SITE.brand}</span>
      <span class="hdr__tag">{SITE.tag}</span>
    </a>
    <nav class="hdr__nav" aria-label="Sections">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="hdr__app" href={APP_URL}>{SITE.backToApp}</a>
  </div>
</header>

<style>
  .hdr {
    background: var(--surface-app);
    border-bottom: var(--hairline);
  }
  .hdr__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .hdr__home {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    text-decoration: none;
  }
  .hdr__brand {
    font-size: var(--text-base);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-snug);
    color: var(--text-strong);
  }
  .hdr__tag {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 14px;
    color: var(--text-accent);
  }
  .hdr__nav {
    display: none;
  }
  .hdr__app {
    margin-left: auto;
    font-size: 13px;
    font-weight: var(--weight-semibold);
    color: var(--text-body);
    text-decoration: none;
    border: var(--hairline-strong);
    border-radius: var(--radius-xs);
    padding: 7px 12px;
    transition: border-color var(--dur-fast) var(--ease-gentle);
  }
  .hdr__app:hover {
    border-color: var(--ink-400);
  }

  @media (min-width: 900px) {
    .hdr {
      position: sticky;
      top: 0;
      z-index: 5;
    }
    .hdr__nav {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-left: auto;
    }
    .hdr__nav a {
      font-size: 13.5px;
      font-weight: var(--weight-semibold);
      color: var(--text-body);
      text-decoration: none;
      transition: color var(--dur-fast) var(--ease-gentle);
    }
    .hdr__nav a:hover {
      color: var(--text-strong);
    }
    .hdr__app {
      margin-left: 0;
    }
  }
</style>
