---
// The status label chip (Curable / Treatable / Usually goes away). Always the word
// plus the heart glyph and a tone color, so it reads in grayscale and for
// color-blind users, matching the app's LabelChip.
import Icon from "./Icon.astro";
interface Props {
  label: string;
  tone: "clear" | "treat" | "none";
}
const { label, tone } = Astro.props;
---

<span class={`info-chip info-chip--${tone}`}><Icon name="heart" size={11} />{label}</span>
