---
// The condition facts strip: how to test, what the status label means, and
// related reading, framed by hairlines. Stacked rows on a phone; equal
// hairline-separated columns when its zone is wide.
import StatusLabel from "./StatusLabel.astro";
import { LIBRARY as c } from "../data/library.ts";

interface Props {
  test: string;
  label: string;
  tone: "clear" | "treat" | "none";
  related?: readonly { label: string; href: string }[] | undefined;
}
const { test, label, tone, related } = Astro.props;
const cols = related && related.length > 0 ? 3 : 2;
---

<div class={`facts facts--${cols}`}>
  <section class="facts__col">
    <h2 class="u-eyebrow facts__head">{c.howToTest}</h2>
    <p class="facts__body">{test}</p>
  </section>
  <section class="facts__col">
    <h2 class="u-eyebrow facts__head">{c.labelsTitle}</h2>
    <p class="facts__label"><StatusLabel label={label} tone={tone} /></p>
    <p class="facts__body">{c.labelNotes[tone]}</p>
  </section>
  {
    related && related.length > 0 && (
      <section class="facts__col">
        <h2 class="u-eyebrow facts__head">{c.relatedLabel}</h2>
        <ul class="facts__links">
          {related.map((r) => (
            <li>
              <a href={r.href}>{r.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>

<style>
  .facts {
    border-top: var(--hairline);
    border-bottom: var(--hairline);
    padding: var(--space-4) 0;
  }
  .facts__col + .facts__col {
    border-top: var(--hairline);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
  }
  .facts__head {
    margin: 0;
  }
  .facts__label {
    margin: var(--space-2) 0 0;
  }
  .facts__body {
    font-size: 14px;
    line-height: var(--leading-normal);
    color: var(--text-body);
    margin: var(--space-2) 0 0;
  }
  .facts__links {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .facts__links a {
    font-size: 14px;
    font-weight: var(--weight-semibold);
    color: var(--text-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @container (min-width: 680px) {
    .facts--2 {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }
    .facts--3 {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }
    .facts--2 .facts__col + .facts__col,
    .facts--3 .facts__col + .facts__col {
      border-top: 0;
      margin-top: 0;
      padding-top: 0;
      border-left: var(--hairline);
      padding-left: var(--grid-gap);
    }
  }
</style>
