---
// Inline SVG icons, the exact same paths as the app's design/icons.tsx so the two
// stay visually identical. Only the handful the library uses are included.
interface Props {
  name:
    | "back"
    | "chevron"
    | "heart"
    | "clock"
    | "mapPin"
    | "shield"
    | "stethoscope"
    | "share"
    | "check"
    | "arrowRight"
    | "lock"
    | "eye"
    | "mail"
    | "circles"
    | "shieldPlus"
    | "care"
    | "users"
    | "calendar";
  size?: number;
  class?: string;
}
const { name, size = 24, class: cls } = Astro.props;

const PATHS: Record<Props["name"], string> = {
  back: '<path d="m15 18-6-6 6-6"></path>',
  chevron: '<path d="m9 18 6-6-6-6"></path>',
  heart:
    '<path d="M12 20s-7-4.5-7-9.5A3.5 3.5 0 0 1 12 7a3.5 3.5 0 0 1 7 3.5C19 15.5 12 20 12 20Z"></path>',
  clock: '<circle cx="12" cy="12" r="9"></circle><path d="M12 8v4l3 2"></path>',
  mapPin:
    '<path d="M20 10c0 5-8 11-8 11s-8-6-8-11a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="2.6"></circle>',
  shield:
    '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z"></path><path d="m9 12 2 2 4-4"></path>',
  stethoscope:
    '<path d="M5 3v5a4 4 0 0 0 8 0V3"></path><path d="M5 3H3.5M13 3h1.5"></path><path d="M9 16v1a4 4 0 0 0 8 0v-2"></path><circle cx="18" cy="11" r="2"></circle>',
  share:
    '<circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="m8.6 13.5 6.8 4"></path><path d="m15.4 6.5-6.8 4"></path>',
  check: '<path d="M5 12.5 10 17 19 7"></path>',
  arrowRight: '<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>',
  lock: '<rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path>',
  eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="m4 7 8 6 8-6"></path>',
  circles:
    '<circle cx="9" cy="9" r="5"></circle><circle cx="16" cy="14" r="5"></circle><circle cx="8" cy="17" r="4"></circle>',
  shieldPlus:
    '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z"></path><path d="M12 9v6M9 12h6"></path>',
  care: '<path d="M19 14c1.5-1.5 2.5-3 2.5-5A4.5 4.5 0 0 0 12 6.5 4.5 4.5 0 0 0 2.5 9c0 2 1 3.5 2.5 5l7 7Z"></path><path d="M3.5 11h4l1.5-3 2 5 1.5-2H17"></path>',
  users:
    '<path d="M16 19v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 17.5V19"></path><circle cx="10" cy="8" r="3.2"></circle><path d="M20 19v-1.5a3.5 3.5 0 0 0-2.6-3.4"></path><path d="M15 5.2a3.2 3.2 0 0 1 0 5.6"></path>',
  calendar:
    '<rect x="3" y="5" width="18" height="16" rx="3"></rect><path d="M3 10h18"></path><path d="M8 3v4"></path><path d="M16 3v4"></path>',
};
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={cls}
  set:html={PATHS[name]}
></svg>
