{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/sw/sw.ts",
    "scripts/**/*.mjs",
    "src/store/index.ts",
    "src/crypto/index.ts",
    "src/design/components/index.ts",
    "src/api/contract.ts"
  ],
  "ignore": [
    "src/design/icons.tsx",
    "lostpixel.config.cjs",
    "ios/**",
    "android/**"
  ],
  "ignoreBinaries": ["go"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "binaries": "error",
    "unlisted": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "duplicates": "error"
  }
}
