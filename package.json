{
  "name": "sti-care",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Find a place to get tested near you, plus simple info on common STIs.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "cd passport && npm run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "behaviors": "node deploy/build-behaviors.mjs",
    "site": "bash deploy/build-site.sh",
    "test": "node --test 'test/**/*.test.mjs'",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "marked": "^18.0.5",
    "prettier": "^3.8.3"
  }
}
